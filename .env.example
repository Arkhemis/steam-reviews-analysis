# Copier en .env (NON commité) et renseigner les valeurs.
# Périmètre actuel : Postgres + IGDB (Metabase / proxy hors périmètre).

# --- Postgres ---
POSTGRES_USER=steam
POSTGRES_PASSWORD=change_me
POSTGRES_DB=steam_reviews
# Pour `dg dev` en local (hors Docker), pointer vers l'hôte :
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- IGDB (OAuth via Twitch client credentials) ---
# https://dev.twitch.tv/console/apps -> Client ID / Client Secret
IGDB_CLIENT_ID=change_me
IGDB_CLIENT_SECRET=change_me

# --- Admin (Caddy basicauth pour dagster.steam.reviews / db.steam.reviews) ---
# Hash généré via : docker run --rm caddy:2 caddy hash-password --plaintext '...'
# IMPORTANT : le hash bcrypt contient des $ (ex: $2a$14$...), interprétés par
# l'interpolation de variables de Docker Compose lors du parsing du .env.
# Échapper chaque $ en $$ ici, sinon le hash est silencieusement corrompu.
ADMIN_BASICAUTH_USER=change_me
ADMIN_BASICAUTH_HASH=change_me

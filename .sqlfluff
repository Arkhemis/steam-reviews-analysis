[sqlfluff]
dialect = postgres
templater = dbt
max_line_length = 140
# ST06: pas de contrainte sur l'ordre des colonnes dans le SELECT.
# RF04: des noms de colonnes sources (ex. `language`) sont des mots-clés SQL.
# ST09: pas de contrainte sur l'ordre des tables dans les JOIN.
exclude_rules = ST06, RF04, ST09

[sqlfluff:templater:dbt]
project_dir = dbt/
profiles_dir = dbt/

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = snake

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

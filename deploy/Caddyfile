{
	email aristalopiteque@proton.me
}

steam.reviews {
	reverse_proxy website:3000

	log {
		output file /var/log/caddy/access.log
	}
}

dagster.steam.reviews {
	basicauth {
		{$ADMIN_BASICAUTH_USER} {$ADMIN_BASICAUTH_HASH}
	}

	reverse_proxy dagster-webserver:3000

	log {
		output file /var/log/caddy/admin-access.log
	}
}

db.steam.reviews {
	basicauth {
		{$ADMIN_BASICAUTH_USER} {$ADMIN_BASICAUTH_HASH}
	}

	reverse_proxy dbgate:3000

	log {
		output file /var/log/caddy/admin-access.log
	}
}

# Interface /play de ClickHouse, protégée par le login ClickHouse : un basicauth
# bloquerait /play, qui envoie « Authorization: never » et met le login dans l'URL.
clickhouse.steam.reviews {
	reverse_proxy clickhouse:8123

	log {
		output file /var/log/caddy/admin-access.log
		# Le mot de passe passe dans l'URL : il ne doit pas finir dans le log.
		format filter {
			request>uri query {
				delete password
			}
		}
	}
}
